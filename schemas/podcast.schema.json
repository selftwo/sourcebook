{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcebook.dev/schemas/podcast.schema.json",
  "title": "podcast script with a parallel citation track",
  "type": "object",
  "required": ["schema_version", "episode", "speakers", "lines"],
  "properties": {
    "schema_version": {"const": 1},
    "episode": {"type": "string", "minLength": 3},
    "outline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "size"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "size": {"type": "string", "enum": ["short", "medium", "long"]}
        },
        "additionalProperties": false
      }
    },
    "speakers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"type": "string"}, "voice_hint": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["n", "speaker", "text", "claims", "kind"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "speaker": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "claims": {"type": "array", "items": {"type": "string"}},
          "kind": {"type": "string", "enum": ["factual", "opinion", "banter", "transition"]},
          "segment": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
