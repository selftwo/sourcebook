{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcebook.dev/schemas/ttsplan.schema.json",
  "title": "provider-agnostic speech synthesis plan",
  "type": "object",
  "required": ["schema_version", "output_dir", "sample_rate", "format", "voices", "segments", "concat"],
  "properties": {
    "schema_version": {"const": 1},
    "output_dir": {"type": "string"},
    "sample_rate": {"type": "integer", "minimum": 8000},
    "format": {"type": "string", "enum": ["wav", "mp3", "flac", "ogg"]},
    "voices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {"hint": {"type": "string"}, "voice_id": {"type": ["string", "null"]}},
        "additionalProperties": false
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "speaker", "text", "pause_after_ms", "out"],
        "properties": {
          "id": {"type": "string", "pattern": "^s\\d{4}$"},
          "speaker": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "pause_after_ms": {"type": "integer", "minimum": 0},
          "out": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "concat": {
      "type": "object",
      "required": ["manifest", "out"],
      "properties": {"manifest": {"type": "string"}, "out": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
