__pycache__/
*.py[cod]
*.tmp

# Worktrees created by the coding harness, not part of the kit.
.claude/worktrees/

# The demo workspace is regenerated by `make demo`. The artifact it produces
# (examples/demo/answer.html) is checked in; the scratch workspace is not.
examples/demo/workspace/

# Frozen third-party captures. The repo ships the runbook and the URLs, never the text.
examples/demo/frozen/

# Local installs made by scripts/install.py --dest .
.codex/
.cursor/
.sourcebook/
dist/
